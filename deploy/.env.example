# Copy via make setup. Keep generated .runtime/deploy.env private.
REGISTRY=rallymark
VERSION=local
BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
PREVIEW_PORT=8081
PREVIEW_DATA_PATH=../.runtime/preview-data
# enabled requires a functioning GPU; disabled keeps services online without inference.
GPU_MODE=enabled
GPU_DEVICE=0
MIN_GPU_MEMORY_GIB=12
WEIGHTS_PATH=../../ftt-demo/weights
CONFIG_FILE=./config.yaml
POSTGRES_PASSWORD=generated-by-make-setup
BUSINESS_DB_PASSWORD=generated-by-make-setup
ALGORITHM_DB_PASSWORD=generated-by-make-setup
INTERNAL_TOKEN=generated-by-make-setup
