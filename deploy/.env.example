# Copy via make setup. Keep generated .runtime/deploy.env private.
REGISTRY=rallymark
VERSION=local
BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
PREVIEW_DATA_PATH=../.runtime/preview-data
# enabled requires a functioning GPU; disabled keeps services online without inference.
GPU_MODE=enabled
# all or comma-separated GPU indices/UUIDs; runtime admission skips busy cards.
GPU_DEVICE=all
GPU_CDI_DEVICE=nvidia.com/gpu=all
GPU_POOL_FILE=./gpu-pool.yaml
MIN_GPU_MEMORY_GIB=12
WEIGHTS_PATH=../../ftt-demo/weights
CONFIG_FILE=./config.yaml
POSTGRES_PASSWORD=generated-by-make-setup
BUSINESS_DB_PASSWORD=generated-by-make-setup
ALGORITHM_DB_PASSWORD=generated-by-make-setup
INTERNAL_TOKEN=generated-by-make-setup

# Named volumes by default; set bind paths on the selected deployment host.
MEDIA_STORAGE=media
ALGORITHM_STORAGE=algorithm-work
# Set when bind paths must reside on a separately mounted data filesystem.
STORAGE_MOUNT=
