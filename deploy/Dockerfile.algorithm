FROM python:3.11-slim-bookworm AS api
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /usr/local/bin/uv
WORKDIR /app
COPY services/algorithm/pyproject.toml services/algorithm/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY services/algorithm/ ./
RUN uv sync --frozen --no-dev
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1
CMD ["uvicorn", "rallymark_algorithm.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8001"]

FROM api AS worker
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg g++ libgomp1 && rm -rf /var/lib/apt/lists/*
RUN uv sync --frozen --no-dev --extra gpu && uv pip install --python .venv/bin/python pip
# CPU NMS extension is compiled against the worker's pinned PyTorch.
RUN cd vendor/ftt/code/third_party/OpenTAD/opentad/models/utils/post_processing/nms && /app/.venv/bin/python -m pip install --no-build-isolation --no-deps .
CMD ["python", "-m", "rallymark_algorithm.worker"]
