FROM python:3.11-slim-bookworm AS dependencies
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /usr/local/bin/uv
WORKDIR /app
COPY services/algorithm/pyproject.toml services/algorithm/uv.lock ./
RUN --mount=type=cache,id=rallymark-uv,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project

FROM dependencies AS gpu-dependencies
RUN sed -i "s@http://deb.debian.org/debian@https://mirrors.tuna.tsinghua.edu.cn/debian@g" /etc/apt/sources.list.d/debian.sources && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=20 update && apt-get install -y --no-install-recommends ffmpeg g++ libgomp1 && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,id=rallymark-uv,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project --extra gpu

FROM dependencies AS api
COPY services/algorithm/ ./
RUN --mount=type=cache,id=rallymark-uv,target=/root/.cache/uv uv sync --frozen --no-dev
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1
CMD ["uvicorn", "rallymark_algorithm.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8001"]

FROM gpu-dependencies AS worker
COPY services/algorithm/ ./
RUN --mount=type=cache,id=rallymark-uv,target=/root/.cache/uv uv sync --frozen --no-dev --extra gpu && uv pip install --python .venv/bin/python pip
# CPU NMS extension is compiled against the worker's pinned PyTorch.
RUN cd vendor/ftt/code/third_party/OpenTAD/opentad/models/utils/post_processing/nms && /app/.venv/bin/python -m pip install --no-build-isolation --no-deps .
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1
CMD ["python", "-m", "rallymark_algorithm.worker"]

FROM api AS dev-worker
RUN sed -i "s@http://deb.debian.org/debian@https://mirrors.tuna.tsinghua.edu.cn/debian@g" /etc/apt/sources.list.d/debian.sources && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=20 update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
CMD ["python", "-m", "rallymark_algorithm.worker"]
