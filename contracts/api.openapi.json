  "components": {
    "schemas": {
      "AnalysisResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Progress"
              },
              {
                "type": "null"
              }
            ]
          },
          "rallies": {
            "items": {
              "$ref": "#/components/schemas/Rally"
            },
            "type": "array",
            "title": "Rallies"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "config_hash": {
            "type": "string",
            "title": "Config Hash"
          },
          "algorithm_version": {
            "type": "string",
            "title": "Algorithm Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "video_id",
          "status",
          "progress",
          "rallies",
          "warnings",
          "error",
          "created_at",
          "config_hash",
          "algorithm_version"
        ],
        "title": "AnalysisResponse"
      },
      "Body_upload_api_v1_videos_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_v1_videos_post"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorInfo"
      },
      "Event": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_]{1,60}$",
            "title": "Name"
          },
          "video_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Video Id"
          },
          "analysis_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Id"
          },
          "properties": {
            "additionalProperties": true,
            "type": "object",
            "maxProperties": 12,
            "title": "Properties"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Event"
      },
      "EventBatch": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "events"
        ],
        "title": "EventBatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Progress": {
        "properties": {
          "completed": {
            "type": "integer",
            "title": "Completed"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "completed",
          "total"
        ],
        "title": "Progress"
      },
      "Rally": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "start_s": {
            "type": "number",
            "title": "Start S"
          },
          "end_s": {
            "type": "number",
            "title": "End S"
          },
          "score": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "score_status": {
            "type": "string",
            "enum": [
              "observed",
              "inferred",
              "unknown"
            ],
            "title": "Score Status",
            "default": "unknown"
          }
        },
        "type": "object",
        "required": [
          "id",
          "start_s",
          "end_s"
        ],
        "title": "Rally"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VideoList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/VideoResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "VideoList"
      },
      "VideoResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "duration_s": {
            "type": "number",
            "title": "Duration S"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "latest_analysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "duration_s",
          "width",
          "height",
          "size_bytes",
          "created_at",
          "expires_at",
          "latest_analysis"
        ],
        "title": "VideoResponse"
      }
    }
  }
}
